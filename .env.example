# Copy this file to .env and fill in real values for local development.
# In production (Railway), set these as environment variables in the dashboard instead.

# Required in production. Generate with: openssl rand -hex 32
SESSION_SECRET=

# development | production
NODE_ENV=development

PORT=3000

# Where data.json is stored. On Railway, point this at your mounted volume (e.g. /data).
DATA_DIR=./data

# bcrypt cost factor
BCRYPT_ROUNDS=12

# Optional: auto-create an admin account on first boot if it doesn't already exist.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin
