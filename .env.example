# Copy this file to .env and fill in real values for local development.
# In production (Vercel), set these as environment variables in the
# dashboard instead — Project → Settings → Environment Variables.

# Required in production. Generate with: openssl rand -hex 32
SESSION_SECRET=e836940cf548b9262789ef1fc62839e40cb4bf1fee9ce9817577c68b31863bb4
# development | production
NODE_ENV=development

PORT=3000

# bcrypt cost factor
BCRYPT_ROUNDS=12

# Optional: auto-create an admin account on first boot if it doesn't already exist.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# ─── Vercel KV ────────────────────────────────────────────────────────────
# Not needed locally — leave these blank and the app falls back to a local
# JSON-file store (data/kv-dev.json) automatically.
#
# In production, add a KV database from your Vercel project's Storage tab
# (Create Database → KV) and Vercel fills these in for you automatically;
# you don't need to type them in by hand. Only set them here if you want
# your local dev server to read/write the SAME production data (optional —
# run `vercel env pull .env` after connecting KV to fetch them).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ─── Password reset emails ────────────────────────────────────────────────
# Public URL of the app, used to build the link in reset emails.
# On Vercel this defaults to your production domain, so it's optional there.
APP_URL=http://localhost:3000

# SMTP account that sends the emails. For Gmail:
#   1. Turn on 2-Step Verification: https://myaccount.google.com/security
#   2. Create an App Password:      https://myaccount.google.com/apppasswords
#   3. Put the 16-character app password in SMTP_PASS (NOT your normal
#      Gmail password).
# If SMTP_USER / SMTP_PASS are blank in development, the reset link is
# printed in the server console instead of being emailed.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Optional display sender, e.g.  TaskFlow <you@gmail.com>
MAIL_FROM=
